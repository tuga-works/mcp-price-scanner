# Copy to .env and fill in your own values. Never commit .env.
# Generate the token at install time, for example: openssl rand -hex 32
PRICE_SCANNER_TOKEN=change-me-at-install

# Optional: persistent browser profile for explicitly enabled login-gated
# sources. Must live OUTSIDE the repository.
# PRICE_SCANNER_PROFILE_DIR=/var/lib/<your-service-user>/browser-profile

# Optional settings (defaults shown).
# PRICE_SCANNER_HOST=127.0.0.1
# PRICE_SCANNER_PORT=8765
# PRICE_SCANNER_CONFIG=config/sources.yaml
# PRICE_SCANNER_HEADLESS=true
# PRICE_SCANNER_LOG_LEVEL=INFO
# PRICE_SCANNER_CACHE_TTL_SECONDS=300
# Extra Host header values accepted when a reverse proxy forwards requests,
# comma separated, for example: <your-host>.<your-tailnet>.ts.net
# PRICE_SCANNER_ALLOWED_HOSTS=
